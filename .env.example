# Set these in Vercel Project Settings > Environment Variables for every environment that serves the app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
# The public app origin; use the production HTTPS URL in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
